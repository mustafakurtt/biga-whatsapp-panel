  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "bun --bun tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "user:create": "bun scripts/create-user.ts",
    "vapid": "bun scripts/vapid.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:typecheck": "tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p web/tsconfig.sw.json"
  },
  "dependencies": {
    "@mustafakurtt/hono-core": "github:mustafakurtt/hono-core#4c533f3c2505dc1d44e32e25e2b02db58a197b67",
    "@tanstack/react-query": "5.104.2",
    "baileys": "7.0.0-rc14",
    "hono": "4.13.13",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.1.2",
    "pino-pretty": "13.2.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  }
