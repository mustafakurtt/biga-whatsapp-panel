# Biga Panel production ayarları.
# Kopyalayın:  cp .env.production.example .env   (bu klasörde, yani deploy/.env)
# Sonra izinleri kısın:  chmod 600 .env
# Bu dosya GİZLİDİR: git'e eklemeyin, kimseyle paylaşmayın.
# Değerlerde "$" karakteri kullanmayın (Docker Compose onu değişken sanar).

# ---------------------------------------------------------------
# Alan adı ve HTTPS (Caddy kullanır)
# ---------------------------------------------------------------
# Panelin açılacağı adres. DNS'te bu adın A kaydı sunucunun IP'sini göstermeli.
DOMAIN=panel.ornek.com
# Let's Encrypt'in sertifika uyarıları göndereceği e-posta.
ACME_EMAIL=siz@ornek.com

# ---------------------------------------------------------------
# Uygulama
# ---------------------------------------------------------------
# Oturum imzalama anahtarı. En az 32 karakter, rastgele. Üretmek için:  openssl rand -hex 32
# Değiştirirseniz herkesin oturumu kapanır (yeniden giriş gerekir).
JWT_SECRET=BURAYA_openssl_rand_hex_32_CIKTISINI_YAPISTIRIN
# HTTPS arkasında MUTLAKA true (çerez sadece HTTPS üzerinden gönderilir).
COOKIE_SECURE=true
# Günlük ayrıntısı: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# ---------------------------------------------------------------
# WhatsApp
# ---------------------------------------------------------------
# Yeni numaranın varsayılan türü. Production'da baileys (gerçek WhatsApp).
PROVIDER=baileys
# Test (mock) numaraları ve /api/dev uçları. Production'da MUTLAKA false.
ALLOW_MOCK=false

# ---------------------------------------------------------------
# Push bildirimleri (web push). Üretmek için (deploy klasöründe):
#   docker compose run --rm --no-deps app bun scripts/vapid.ts
# Çıkan iki satırı buraya yapıştırın. Bir kez üretin; değiştirirseniz herkes
# bildirimleri yeniden açmak zorunda kalır.
# ---------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Push servislerinin (Apple, Google, Mozilla) sorun olursa ulaşacağı gerçek adres.
# example.com bırakmayın; Apple bazı geçersiz adresleri reddeder.
VAPID_SUBJECT=mailto:siz@ornek.com

# ---------------------------------------------------------------
# Aşağıdakiler docker-compose.yml içinde sabitlenmiştir; burada değiştirmeniz etkisizdir.
# Bilgi için listelenmiştir.
# ---------------------------------------------------------------
# NODE_ENV=production
# HOST=0.0.0.0
# PORT=3000
# DATABASE_PATH=/app/data/app.db
# BAILEYS_AUTH_DIR=/app/data/baileys
# STATIC_DIR=/app/web/dist
