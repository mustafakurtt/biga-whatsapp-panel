# Kopyalayıp .env yapın. Bun .env dosyasını kendisi okur.
NODE_ENV=development
PORT=3000
# En az 32 karakter rastgele bir değer (ör. bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())")
JWT_SECRET=
# HTTPS arkasında yayınlıyorsanız true
COOKIE_SECURE=false
DATABASE_PATH=./data/app.db

# Yeni numaranın varsayılan türü. baileys: gerçek WhatsApp. mock: test numarası (WhatsApp'a gitmez).
PROVIDER=baileys
# Test numaralarına izin (boş: production dışında açık)
ALLOW_MOCK=
BAILEYS_AUTH_DIR=./data/baileys

# Push bildirimleri (isteğe bağlı): bun run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
